---
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return [2023, 2024, 2025, 2026].map((year) => ({
    params: { year: String(year) },
  }));
}

const { year } = Astro.params;
---

<Base title={`${year} · Midy's Adventure`}>
  <h1 class="sr-only">{year}</h1>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
