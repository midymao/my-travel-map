---
import Base from "../layouts/Base.astro";
import HomeGlobe from "../components/HomeGlobe.astro";
import HomeLoading from "../components/HomeLoading.astro";
---

<Base
  title="Midy's Travel Map"
  description="一颗会转动的地球，记录我去过的国家和城市。"
  flush
>
  <link slot="head" rel="preload" as="image" href="/textures/earth-day-4k.webp" media="(pointer: coarse)" crossorigin="anonymous" fetchpriority="high" />
  <HomeLoading />
  <div data-home-content>
  <HomeGlobe />
  <main style="max-width:860px;margin:0 auto;padding:1rem 1.5rem 5rem">
    <p><a href="/places/" style="color:#9ecbff">查看全部地点 →</a></p>
    <p style="margin-top:4rem;font-size:.75rem;opacity:.4;line-height:1.7">
      地球影像：NASA Blue Marble 与 Solar System Scope（CC BY 4.0）。<br />
      高清卫星影像：<a href="https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer" style="color:inherit">Esri World Imagery</a>，来源包括 Esri、Maxar、Earthstar Geographics 及 GIS 用户社区。
      <br />中国省级边界：<a href="https://geojson.cn/data/atlas/tiandi" style="color:inherit">GeoJSON.CN（天地图数据）</a>。
    </p>
  </main>
  </div>
</Base>
