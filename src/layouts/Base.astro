---
import SiteHeader from "../components/SiteHeader.astro";
import PageScrollbar from "../components/PageScrollbar.astro";
const { title, description = "我的旅行地图", flush = false } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body id="page-scroll-content">
    <SiteHeader />
    {
      flush ? (
        <slot />
      ) : (
        <main class="page-content">
          <slot />
        </main>
      )
    }
    <PageScrollbar />
  </body>
</html>

<style>
  :global(html) {
    --site-header-height: 76px;
    scroll-padding-top: var(--site-header-height);
    scrollbar-gutter: stable;
  }
  @media (hover: hover) and (pointer: fine) and (forced-colors: none) {
    :global(html) {
      --scrollbar-track: #0d0d0f;
      --scrollbar-thumb: #636368;
    }
    @supports selector(::-webkit-scrollbar) {
      :global(html::-webkit-scrollbar) {
        width: 12px;
      }
      :global(html::-webkit-scrollbar-track:vertical) {
        background: var(--scrollbar-track);
      }
      :global(html::-webkit-scrollbar-thumb:vertical) {
        background: var(--scrollbar-thumb);
        background-clip: padding-box;
        border: 3px solid transparent;
        border-radius: 999px;
      }
      :global(html::-webkit-scrollbar-thumb:vertical:hover) {
        background-color: #85858b;
      }
      :global(html::-webkit-scrollbar-thumb:vertical:active) {
        background-color: #a5a5ab;
      }
      :global(html::-webkit-scrollbar-button:vertical) {
        display: none;
      }
    }
    @supports not selector(::-webkit-scrollbar) {
      :global(html) {
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
      }
    }
  }
  body {
    margin: 0;
    padding-top: var(--site-header-height);
    background: #050505;
    color: #f5f5f7;
    font-family: system-ui, sans-serif;
  }
  .page-content {
    max-width: 860px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  @media (max-width: 480px) {
    .page-content { padding-top: 2.5rem; }
  }
  @media (max-width: 760px), (max-width: 1024px) and (pointer: coarse) {
    :global(html) { --site-header-height: 72px; }
  }
</style>
