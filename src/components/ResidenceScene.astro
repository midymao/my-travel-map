<style>
  .residence-scene { display: block; width: 100%; height: 72px; overflow: hidden; opacity: 0.46; transition: opacity 350ms ease; }
  :global(.residence-link:is(:hover, :focus-visible)) .residence-scene { opacity: 0.9; }
  .water, .lotus-sway, .reflection, .steam-line, .panda-sway, .panda-breathe, .koala-sway, .leaf-sway, .wheat-sway, .blink {
    animation-play-state: paused !important;
  }
  :global(.residence-link:is(:hover, :focus-visible)) :is(.water, .lotus-sway, .reflection, .steam-line, .panda-sway, .panda-breathe, .koala-sway, .leaf-sway, .wheat-sway, .blink) {
    animation-play-state: running !important;
  }
  .water { animation: river-flow 3.6s ease-in-out infinite; }
  .reflection { animation: shimmer 3s ease-in-out infinite; }
  .lotus-sway { transform-box: fill-box; transform-origin: 50% 100%; animation: lotus-breeze 5s ease-in-out infinite; }
  .steam-line { animation: steam-rise 2.8s ease-in-out infinite; }
  .panda-sway, .koala-sway { transform-box: fill-box; transform-origin: 50% 95%; animation: animal-sway 4s ease-in-out infinite; }
  .panda-breathe { transform-box: fill-box; transform-origin: 50% 100%; animation: sleeping-breath 4.8s ease-in-out infinite; }
  .leaf-sway { transform-box: fill-box; transform-origin: 50% 100%; animation: leaf-breeze 4.5s ease-in-out infinite; }
  .wheat-sway { transform-box: fill-box; transform-origin: 50% 100%; animation: wheat-breeze 3.8s ease-in-out infinite; }
  .blink { transform-box: fill-box; transform-origin: center; animation: blink 5s ease-in-out infinite; }
  @keyframes river-flow { 0%, 100% { transform: translateX(-2px); } 50% { transform: translateX(3px); } }
  @keyframes shimmer { 0%, 100% { opacity: 0.3; transform: translateX(-1px); } 50% { opacity: 0.65; transform: translateX(2px); } }
  @keyframes lotus-breeze { 0%, 100% { transform: rotate(-2deg); } 50% { transform: rotate(3deg); } }
  @keyframes steam-rise { 0% { opacity: 0.15; transform: translate(0, 3px); } 50% { opacity: 0.8; } 100% { opacity: 0; transform: translate(3px, -6px); } }
  @keyframes animal-sway { 0%, 100% { transform: rotate(-2deg); } 50% { transform: rotate(2deg); } }
  @keyframes sleeping-breath { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.035); } }
  @keyframes leaf-breeze { 0%, 100% { transform: rotate(-2deg); } 50% { transform: rotate(3deg); } }
  @keyframes wheat-breeze { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(4deg); } }
  @keyframes blink { 0%, 42%, 48%, 100% { transform: scaleY(1); } 45% { transform: scaleY(0.15); } }
  @media (max-height: 700px) {
    .residence-scene { height: 64px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .residence-scene { transition: none; }
    .water, .lotus-sway, .reflection, .steam-line, .panda-sway, .panda-breathe, .koala-sway, .leaf-sway, .wheat-sway, .blink { animation: none !important; }
  }
</style>
