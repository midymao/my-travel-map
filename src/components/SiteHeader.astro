---
import { residences } from "../data/residences";
import ResidenceScene from "./ResidenceScene.astro";

const menus = [
  {
    id: "yearly",
    label: "Yearly",
    description: "年度目录",
    links: [2023, 2024, 2025, 2026].map((year) => ({
      name: String(year),
      href: `/yearly/${year}/`,
    })),
  },
  {
    id: "residence",
    label: "Residence",
    description: "居住地区目录",
    links: residences.map(({ slug, name }) => ({
      name,
      href: `/residence/${slug}/`,
    })),
  },
];
---

<header class="site-header">
  <nav aria-label="主导航">
    <a class="brand" href="/" aria-label="Midy's Adventure，返回首页">
      <svg class="brand-logo" viewBox="0 0 84 68" fill="none" aria-hidden="true">
        <ellipse class="model-shadow" cx="39" cy="61" rx="20" ry="2" stroke="currentColor" opacity="0.2" />
        <g class="pedestal" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
          <path d="M39 34v18M35 34h8" />
          <ellipse cx="39" cy="55" rx="16" ry="4" />
          <path d="M23 55v3c0 5 32 5 32 0v-3" />
        </g>
        <path class="flight-trail" d="M42 46c-24-2-27-12-6-15 24-3 29-12 4-15" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-dasharray="3 5" />
        <g class="aircraft" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" stroke-linecap="round" fill="#080808">
          <path d="m38 25-14-14 10 1 23 12z" />
          <path d="m18 28-5-13 7 2 10 11z" />
          <path d="m16 28-9 7 17-3 8-4z" />
          <path d="m18 26 43-8c7-1 12 2 12 6 0 3-5 6-12 6l-40 2z" />
          <path d="m43 25-17 20 10 1 24-20z" />
          <path d="m48 20 10-1 5 4-14 2z" />
          <g class="propeller">
            <path d="M72 14v20" />
            <circle cx="72" cy="24" r="1.8" />
          </g>
        </g>
      </svg>
      <span class="brand-title">Midy's Adventure</span>
    </a>
    <div class="header-actions">
      {menus.map((menu) => (
        <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls={`${menu.id}-menu`} aria-expanded="false">{menu.label}</button>
      ))}
    </div>
  </nav>
</header>

<div class="drawer-shade" hidden aria-hidden="true"></div>

{menus.map((menu) => (
  <dialog id={`${menu.id}-menu`} class="nav-drawer" aria-labelledby={`${menu.id}-heading`}>
    <div class="drawer-heading">
      <h2 id={`${menu.id}-heading`}>{menu.label}</h2>
      <button class="drawer-close" type="button" aria-label={`关闭${menu.description}`}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4" /></svg>
      </button>
    </div>
    <nav class="menu-links" aria-label={menu.description}>
      {menu.links.map((link) => (
        <a class:list={{ "residence-link": menu.id === "residence" }} href={link.href} aria-current={Astro.url.pathname === link.href ? "page" : undefined}>
          <span>{link.name}</span>
          {menu.id === "residence" && <ResidenceScene slug={link.href.split("/")[2]} />}
        </a>
      ))}
    </nav>
  </dialog>
))}

<script>
  type Menu = { toggle: HTMLButtonElement; drawer: HTMLDialogElement };
  const shade = document.querySelector<HTMLElement>(".drawer-shade")!;
  let active: Menu | null = null;
  let closeTimer: number | undefined;
  let previousOverflow = "";

  function closeMenu() {
    if (!active || closeTimer !== undefined) return;
    const menu = active;
    menu.drawer.classList.add("is-closing");
    shade.classList.add("is-closing");
    const duration = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 220;
    closeTimer = window.setTimeout(() => {
      menu.drawer.close();
      menu.drawer.classList.remove("is-closing", "is-switching");
      menu.toggle.setAttribute("aria-expanded", "false");
      shade.hidden = true;
      shade.classList.remove("is-closing");
      document.documentElement.style.overflow = previousOverflow;
      active = null;
      closeTimer = undefined;
      menu.toggle.focus({ preventScroll: true });
    }, duration);
  }

  document.querySelectorAll<HTMLButtonElement>(".menu-toggle").forEach((toggle) => {
    const drawer = document.getElementById(toggle.getAttribute("aria-controls") ?? "") as HTMLDialogElement | null;
    if (!drawer) return;
    toggle.addEventListener("click", () => {
      if (active?.toggle === toggle) {
        closeMenu();
        return;
      }
      window.clearTimeout(closeTimer);
      closeTimer = undefined;
      const switching = active !== null;
      if (active) {
        active.drawer.close();
        active.drawer.classList.remove("is-closing", "is-switching");
        active.toggle.setAttribute("aria-expanded", "false");
      } else {
        previousOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = "hidden";
      }
      active = { toggle, drawer };
      shade.hidden = false;
      shade.classList.remove("is-closing");
      drawer.classList.toggle("is-switching", switching);
      // A non-modal dialog keeps both header buttons available above the shade.
      drawer.show();
      toggle.setAttribute("aria-expanded", "true");
    });
    drawer.querySelector(".drawer-close")?.addEventListener("click", closeMenu);
  });
  shade.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (event) => {
    if (!active) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeMenu();
    } else if (event.key === "Tab") {
      // Keep keyboard navigation within the header and the currently open menu.
      const controls = [
        ...document.querySelectorAll<HTMLElement>(".site-header a, .site-header button"),
        ...active.drawer.querySelectorAll<HTMLElement>("button, a[href]"),
      ];
      const index = controls.indexOf(document.activeElement as HTMLElement);
      const next = index < 0 ? (event.shiftKey ? controls.length - 1 : 0)
        : (index + (event.shiftKey ? -1 : 1) + controls.length) % controls.length;
      event.preventDefault();
      controls[next]?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    height: var(--site-header-height);
    z-index: 100;
    box-sizing: border-box;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(8, 8, 8, 0.52);
    backdrop-filter: blur(24px) saturate(115%);
    -webkit-backdrop-filter: blur(24px) saturate(115%);
  }
  .site-header nav {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-inline: clamp(1rem, 3vw, 3rem);
  }
  .header-actions { display: flex; align-items: center; gap: 0.65rem; flex: 0 0 auto; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    height: 100%;
    color: #f1f5f7;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .brand:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -3px;
    border-radius: 10px;
  }
  .brand-logo {
    width: 76px;
    height: 62px;
    flex: 0 0 auto;
    overflow: visible;
  }
  .brand-title {
    position: relative;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.025em;
    white-space: nowrap;
    transition: color 220ms ease;
  }
  .brand-title::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }
  .aircraft {
    transform-box: view-box;
    transform-origin: 42px 29px;
    transition: transform 450ms ease;
  }
  .propeller {
    transform-box: view-box;
    transform-origin: 72px 24px;
  }
  .model-shadow {
    transform-origin: 39px 60px;
    transition: opacity 400ms ease, transform 400ms ease;
  }
  .flight-trail {
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .brand:is(:hover, :focus-visible) .brand-title { color: #fff; }
  .brand:is(:hover, :focus-visible) .brand-title::after { transform: scaleX(1); }
  .brand:is(:hover, :focus-visible) .aircraft {
    transform: translate(1px, -15px) rotate(-8deg) scale(0.88);
    animation: spiral-takeoff 1400ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }
  .brand:is(:hover, :focus-visible) .propeller {
    animation: propeller-spin 160ms linear infinite;
  }
  .brand:is(:hover, :focus-visible) .flight-trail { opacity: 0.55; }
  .brand:is(:hover, :focus-visible) .model-shadow {
    opacity: 0.25;
    transform: scaleX(0.65);
  }
  @keyframes spiral-takeoff {
    0% { transform: translate(0, 0) rotate(0) scale(1); }
    20% { transform: translate(8px, -3px) rotate(-12deg) scale(0.95); }
    40% { transform: translate(-9px, -8px) rotate(-24deg) scale(0.82); }
    60% { transform: translate(-8px, -17px) rotate(9deg) scale(0.8); }
    80% { transform: translate(7px, -20px) rotate(16deg) scale(0.84); }
    100% { transform: translate(1px, -15px) rotate(-8deg) scale(0.88); }
  }
  @keyframes propeller-spin {
    to { transform: rotate(360deg); }
  }
  .menu-toggle, .drawer-close {
    font: inherit;
    color: #f1f5f7;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .menu-toggle {
    position: relative;
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0.5rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035), 0 1px 2px rgba(0, 0, 0, 0.1);
    color: #c6c9cd;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.035em;
    transition: color 220ms ease, background 220ms ease, border-color 220ms ease;
  }
  .menu-toggle:is(:hover, :focus-visible) { color: #fff; background: rgba(255, 255, 255, 0.055); border-color: rgba(255, 255, 255, 0.14); }
  .menu-toggle[aria-expanded="true"] { color: #fff; background: rgba(255, 255, 255, 0.075); border-color: rgba(255, 255, 255, 0.16); }
  .menu-toggle:active { background: rgba(255, 255, 255, 0.035); }
  .drawer-shade {
    position: fixed;
    inset: var(--site-header-height) 0 0;
    z-index: 98;
    background: rgba(0, 0, 0, 0.38);
    animation: shade-in 250ms ease both;
  }
  .drawer-shade[hidden] { display: none; }
  .drawer-shade.is-closing { animation: shade-in 220ms ease reverse both; }
  .nav-drawer {
    position: fixed;
    z-index: 99;
    inset: var(--site-header-height) 0 0 auto;
    box-sizing: border-box;
    width: min(384px, 100%);
    height: calc(100dvh - var(--site-header-height));
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 2rem;
    border: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.09);
    color: #e4e6e9;
    background: rgba(14, 16, 19, 0.72);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    box-shadow: -12px 0 48px rgba(0, 0, 0, 0.12);
  }
  .nav-drawer[open] { animation: drawer-in 320ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .nav-drawer.is-switching { animation: none; }
  .nav-drawer.is-closing { animation: drawer-in 220ms ease reverse both; }
  .drawer-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.75rem; }
  .drawer-heading h2 { margin: 0; font-size: 1.2rem; font-weight: 500; letter-spacing: 0.035em; }
  .drawer-close { display: grid; place-items: center; width: 44px; height: 44px; padding: 10px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: #aeb3ba; transition: color 220ms ease, background 220ms ease; }
  .drawer-close svg { width: 24px; height: 24px; }
  .drawer-close:is(:hover, :focus-visible) { color: #fff; background: rgba(255, 255, 255, 0.045); }
  .drawer-close:active { background: rgba(255, 255, 255, 0.025); }
  .menu-links { display: flex; flex-direction: column; }
  .menu-links a {
    display: flex;
    align-items: center;
    min-height: 76px;
    box-sizing: border-box;
    padding: 1.35rem 0.75rem;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.075);
    background: transparent;
    color: #c5c9ce;
    text-decoration: none;
    font-size: 1.05rem;
    line-height: 1.6;
    font-weight: 400;
    letter-spacing: 0.015em;
    transition: color 220ms ease, background 220ms ease;
  }
  #yearly-menu .menu-links a { font-size: 1.5rem; letter-spacing: 0.075em; font-variant-numeric: tabular-nums; }
  .menu-links a:is(:hover, :focus-visible) { color: #fff; background: rgba(255, 255, 255, 0.035); }
  .menu-links a[aria-current="page"] { color: #fff; background: rgba(255, 255, 255, 0.045); }
  .menu-links a:active { background: rgba(255, 255, 255, 0.02); }
  .menu-links a > span:first-child { min-width: 0; overflow-wrap: anywhere; }
  #residence-menu .drawer-heading { margin-bottom: 1rem; }
  .menu-links .residence-link { flex-direction: column; align-items: stretch; gap: 0.4rem; padding: 0.8rem 0.75rem; font-size: 1rem; }
  .menu-toggle:focus-visible, .drawer-close:focus-visible, .menu-links a:focus-visible { outline: 1px solid rgba(255, 255, 255, 0.7); outline-offset: 3px; }
  @keyframes drawer-in { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @keyframes shade-in { from { opacity: 0; } to { opacity: 1; } }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header, .nav-drawer { background: rgba(8, 8, 8, 0.94); }
  }
  @media (max-width: 760px), (max-width: 1024px) and (pointer: coarse) {
    .site-header nav { flex-direction: row; align-items: center; justify-content: space-between; }
    .brand { min-width: 56px; height: 100%; gap: 0; justify-content: center; }
    .brand-logo { width: 56px; height: 50px; }
    .brand-title { display: none; }
    .header-actions { align-self: center; padding-bottom: 0; }
  }
  @media (max-width: 480px) {
    .menu-toggle { font-size: 0.9rem; padding-inline: 0.75rem; }
  }
  @media (max-width: 360px) {
    .brand-logo { width: 46px; }
    .site-header nav { padding-inline: 0.65rem; gap: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-drawer[open], .drawer-shade { animation: none; }
    .menu-toggle, .drawer-close, .menu-links a { transition: none; }
  }
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .brand .aircraft, .brand .propeller { animation: none !important; transform: none !important; }
    .brand .flight-trail { opacity: 0 !important; }
    .brand .model-shadow { opacity: 0.6 !important; transform: none !important; }
    .brand-title, .brand-title::after, .aircraft, .model-shadow, .flight-trail { transition: none; }
  }
</style>
